APP_NAME=Roicard
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=roicard
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=
SESSION_DOMAIN=

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

FILESYSTEM_CLOUD=s3

VITE_APP_NAME="${APP_NAME}"

# Payment Aggregator (Paystack or Hubtel)
PAYMENT_PROVIDER=mock
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
HUWTEL_CLIENT_ID=
HUWTEL_CLIENT_SECRET=

# Media Library
MEDIA_DISK=public

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="hello@roicard.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/social/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/auth/social/facebook/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/social/linkedin/callback

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/api/auth/social/x/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
