# Roicard Laravel queue worker
# Place at /etc/systemd/system/roicard-worker.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now roicard-worker
[Unit]
Description=Roicard Laravel queue worker
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/roicard
ExecStart=/usr/bin/php artisan queue:work database --sleep=3 --tries=3 --max-time=3600
Restart=always
RestartSec=5
Environment="QUEUE_CONNECTION=database"

[Install]
WantedBy=multi-user.target
